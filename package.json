{
  "name": "reflow-404",
  "private": true,
  "version": "6.4.0",
  "type": "module",
  "description": "RE:FLOW 404《断点之城》——五城探索，从雨港、白噪雪原走进镜库城；扫描因果、修复规则并运行多情景回归。",
  "scripts": {
