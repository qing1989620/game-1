    "release:check": "npm run verify && node scripts/check-release.mjs --strict"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
